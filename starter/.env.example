DATABASE_URL=postgres://controlroom:controlroom@localhost:5438/controlroom
S3_ENDPOINT=http://127.0.0.1:9009
S3_ACCESS_KEY_ID=controlroom
S3_SECRET_ACCESS_KEY=controlroom-local-only
S3_BUCKET=controlroom-attachments

# Local fictional incident workflow. Set a private demo operator token.
INCIDENT_OPERATOR_TOKEN=
GEMINI_API_KEY=
AGENT_MODEL=gemini-3.5-flash-lite
AGENT_ALLOWED_MODELS=gemini-3.5-flash-lite

# Optional second provider; no fallback unless explicitly configured.
AGENT_PROVIDER=gemini
AGENT_FALLBACK_PROVIDER=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_ALLOWED_MODELS=gemini-3.5-flash-lite
XAI_API_KEY=
GROK_MODEL=grok-4.7
GROK_ALLOWED_MODELS=grok-4.7

# Existing Python agent used by the incident dataset dashboard.
# Alternative: private groq_api_key.txt at the repository root.
GROQ_API_KEY=
# Optional: directory containing problems.jsonl and test_cases*.jsonl.
# PROBLEMS_DIR=/absolute/path/to/agent/problems/data

# Iteration-2 ferry agent: explicit per-incident provider selection in the UI.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_ALLOWED_MODELS=openai/gpt-oss-120b
# GEMINI_MODEL / GEMINI_ALLOWED_MODELS above configure the same loop with Gemini.

# Optional simulated-driver voice. Never use NEXT_PUBLIC_ for this key.
# Requires an explicitly authorized live test and a private agent with a 120s duration cap.
ELEVENLABS_LIVE_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
